# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env a Git.

# Secreto JWT — genera uno con: openssl rand -hex 32
JWT_SECRET=reemplaza_esto_con_un_secreto_seguro

# MongoDB — genera la contraseña con: openssl rand -hex 16
MONGO_USER=reemplaza por nombre de usuario de la base de datos
MONGO_PASSWORD=reemplaza por contraseña de la base de datos
MONGO_DATABASE=reemplaza por nombre de la base de datos

MAIL_USERNAME=correo de la empresa
MAIL_PASSWORD=contraseña para applicaciones de correo (no es la contraseña normal, sino una específica para apps)

# Credenciales del administrador — NO se guardan en la base de datos
ADMIN_EMAIL=reemplaza por correo del administrador
ADMIN_PASSWORD=reemplaza por contraseña segura para el administrador