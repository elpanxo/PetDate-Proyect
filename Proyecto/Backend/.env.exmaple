# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env a Git.

# Secreto JWT — genera uno con: openssl rand -hex 32
JWT_SECRET=codigo-secreto-jwt de mas de 32 caracteres

# MongoDB — genera la contraseña con: openssl rand -hex 16
MONGO_USER=usuario de la base de datos
MONGO_PASSWORD=contraseña de la base de datos
MONGO_DATABASE=nombre de la base de datos

MAIL_USERNAME=usuario de correo electrónico
MAIL_PASSWORD=contraseña de correo electrónico de applicacion

# Credenciales del administrador — NO se guardan en la base de datos
ADMIN_EMAIL=correo electrónico del administrador
ADMIN_PASSWORD=contraseña del administrador